<mxfile host="app.diagrams.net" modified="2026-08-20T09:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="fig_2_1_collaborative_links" name="Collaborative Links 2-hop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User u1 Box -->
        <mxCell id="u1_box" value="User u&lt;sub&gt;1&lt;/sub&gt;&#xa;(Người nhận gợi ý)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- User u2 Box -->
        <mxCell id="u2_box" value="User u&lt;sub&gt;2&lt;/sub&gt;&#xa;(Người cùng sở thích)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Shared Item i1 -->
        <mxCell id="i1_box" value="Item i&lt;sub&gt;1&lt;/sub&gt;&#xa;(Sản phẩm dùng chung làm cầu nối)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Target Item i2 -->
        <mxCell id="i2_box" value="Item i&lt;sub&gt;2&lt;/sub&gt;&#xa;(Sản phẩm mà u&lt;sub&gt;2&lt;/sub&gt; đã đánh giá cao)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Solid Links for History Interactions -->
        <mxCell id="hist_u1_i1" value="u&lt;sub&gt;1&lt;/sub&gt; đã xem i&lt;sub&gt;1&lt;/sub&gt;" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1_box" target="i1_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="hist_u2_i1" value="u&lt;sub&gt;2&lt;/sub&gt; đã xem i&lt;sub&gt;1&lt;/sub&gt;" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2_box" target="i1_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="hist_u2_i2" value="u&lt;sub&gt;2&lt;/sub&gt; đã xem &amp;amp; thích i&lt;sub&gt;2&lt;/sub&gt;" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2_box" target="i2_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Message Passing Flow: 1-hop & 2-hop Curved Arrows -->
        <mxCell id="msg_hop1" value="[Lan truyền Chặng 1]:&#xa;Đặc trưng của u&lt;sub&gt;2&lt;/sub&gt; truyền vào i&lt;sub&gt;1&lt;/sub&gt;" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontStyle=1;fontColor=#000000;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2_box" target="i1_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg_hop2" value="[Lan truyền Chặng 2]:&#xa;i&lt;sub&gt;1&lt;/sub&gt; truyền thông điệp của u&lt;sub&gt;2&lt;/sub&gt; sang u&lt;sub&gt;1&lt;/sub&gt;" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontStyle=1;fontColor=#000000;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1_box" target="u1_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Final Recommendation Dashed Arrow -->
        <mxCell id="arr_rec" value="★ KẾT QUẢ: u&lt;sub&gt;1&lt;/sub&gt; tự động được gợi ý Item i&lt;sub&gt;2&lt;/sub&gt; (Nhờ tín hiệu cộng tác 2-hop truyền từ u&lt;sub&gt;2&lt;/sub&gt;)" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#000000;strokeWidth=2.5;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1_box" target="i2_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="390" />
              <mxPoint x="500" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Bottom Summary Box -->
        <mxCell id="box_sum" value="KẾT LUẬN LIÊN KẾT:&#xa;Dù u&lt;sub&gt;1&lt;/sub&gt; và u&lt;sub&gt;2&lt;/sub&gt; không có cạnh nối trực tiếp, mạng đồ thị vẫn tự động thiết lập liên kết cộng tác gián tiếp u&lt;sub&gt;1&lt;/sub&gt; ──► i&lt;sub&gt;1&lt;/sub&gt; ──► u&lt;sub&gt;2&lt;/sub&gt;, giúp u&lt;sub&gt;1&lt;/sub&gt; khám phá được các sản phẩm mới phù hợp với gu sở thích." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="780" height="65" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
