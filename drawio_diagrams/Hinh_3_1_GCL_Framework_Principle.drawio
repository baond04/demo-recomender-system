        <!-- Source Graph Box -->
        <mxCell id="src_g" value="ĐỒ THỊ TƯƠNG TÁC GỐC G&#xa;(Chứa nút người dùng u và các lân cận)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="30" width="420" height="55" as="geometry" />
        </mxCell>

        <!-- View 1 -->
        <mxCell id="v1" value="GÓC NHÌN 1 (View 1)&#xa;Biểu diễn nhúng: z&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
