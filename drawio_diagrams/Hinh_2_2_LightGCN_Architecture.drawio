        <!-- KHỐI 4: TỔNG HỢP MEAN POOLING (READOUT) -->
        <mxCell id="frame_pool" value="KHỐI TỔNG HỢP ĐA TẦNG (MEAN POOLING READOUT)&#xa;Hòa trộn 3 cấp độ: e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; = 1/3 (e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(0)&lt;/sup&gt; + e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt; + e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt;)  &amp;amp;  e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; = 1/3 (e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(0)&lt;/sup&gt; + e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt; + e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
